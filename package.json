{
  "name": "carboneum-v4",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22.15" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @carboneum/api dev",
    "dev:web": "pnpm --filter @carboneum/web dev",
    "db:migrate": "pnpm --filter @carboneum/api migrate",
    "status": "pnpm --filter @carboneum/api status"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
